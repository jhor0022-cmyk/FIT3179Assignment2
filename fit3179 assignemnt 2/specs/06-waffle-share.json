{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: 100 squares, each 1 percent of world CO2 emissions, coloured by the seven largest emitters and the rest of the world.",
  "title": "Who emits the world's CO₂? (1 square = 1%)",
  "data": {
    "url": "data/waffle.csv"
  },
  "width": {
    "step": 30
  },
  "height": {
    "step": 30
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.1
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.1
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "sort": {
        "field": "rank",
        "op": "min"
      },
      "scale": {
        "range": [
          "#d35e38",
          "#176b65",
          "#7d6a9f",
          "#b08b30",
          "#4e8492",
          "#8c613c",
          "#d77fb3",
          "#cfd3cc"
        ]
      },
      "legend": {
        "title": "Share of world CO₂",
        "orient": "right"
      }
    },
    "order": {
      "field": "cell",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "group",
        "title": "Group"
      },
      {
        "field": "share_pct",
        "title": "Share of world CO₂ (%)",
        "type": "quantitative",
        "format": ".1f"
      }
    ]
  },
  "background": "#fffef9",
  "config": {
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#e4e8e0",
      "domainColor": "#9aa8a3",
      "tickColor": "#9aa8a3",
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#172d2c",
      "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    }
  }
}