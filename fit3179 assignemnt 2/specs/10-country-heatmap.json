{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": {
    "step": 28
  },
  "description": "Heatmap of average annual CO2 emissions per decade for the twelve largest emitters; the last column covers 2020 to the latest year.",
  "title": "Average annual CO₂ emissions by decade, 12 largest emitters",
  "data": {
    "url": "data/heatmap.csv"
  },
  "encoding": {
    "x": {
      "field": "decade",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "orient": "top"
      }
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": {
        "field": "order",
        "op": "min"
      },
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fffef9",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "avg_co2",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "scheme": "tealblues"
          },
          "legend": {
            "title": "Mt CO₂ per year",
            "orient": "bottom",
            "direction": "horizontal",
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "decade",
            "title": "Period"
          },
          {
            "field": "avg_co2",
            "title": "Average Mt CO₂ per year",
            "type": "quantitative",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "avg_co2",
          "type": "quantitative",
          "format": ",.0f"
        },
        "color": {
          "condition": {
            "test": "datum.avg_co2 > 3500",
            "value": "#ffffff"
          },
          "value": "#172d2c"
        }
      }
    }
  ],
  "background": "#fffef9",
  "config": {
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#e4e8e0",
      "domainColor": "#9aa8a3",
      "tickColor": "#9aa8a3",
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#172d2c",
      "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    }
  }
}