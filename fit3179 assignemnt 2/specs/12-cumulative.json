{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": 300,
  "description": "Cumulative CO2 emissions since 1850 for the eight largest cumulative emitters plus Australia and Malaysia.",
  "title": "Cumulative CO₂ emissions since 1850 (billion tonnes)",
  "data": {
    "url": "data/cumulative.csv"
  },
  "mark": {
    "type": "line",
    "interpolate": "monotone"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "axis": {
        "format": "d",
        "tickCount": 8
      },
      "scale": {
        "nice": false
      }
    },
    "y": {
      "field": "cum_gt",
      "type": "quantitative",
      "title": "Billion tonnes of CO₂"
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "scale": {
        "scheme": "tableau10"
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "columns": 3
      }
    },
    "strokeWidth": {
      "condition": {
        "test": "datum.country == 'Australia' || datum.country == 'Malaysia'",
        "value": 3.5
      },
      "value": 1.8
    },
    "tooltip": [
      {
        "field": "country",
        "title": "Country"
      },
      {
        "field": "year",
        "title": "Year",
        "type": "quantitative",
        "format": "d"
      },
      {
        "field": "cum_gt",
        "title": "Cumulative CO₂ (Gt)",
        "type": "quantitative",
        "format": ".1f"
      }
    ]
  },
  "background": "#fffef9",
  "config": {
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#e4e8e0",
      "domainColor": "#9aa8a3",
      "tickColor": "#9aa8a3",
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#172d2c",
      "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    }
  }
}