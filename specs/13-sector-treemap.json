{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap of one country's CO2 emissions by sector from EDGAR. The country is chosen with a drop-down (signal 'iso').",
  "width": 860,
  "height": 360,
  "padding": 8,
  "autosize": "pad",
  "background": "#fffef9",
  "title": {
    "text": {
      "signal": "countryName + ': CO₂ emissions by sector, ' + edgarYear + ' (million tonnes)'"
    },
    "anchor": "start",
    "offset": 10,
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "fontSize": 14,
    "fontWeight": 600,
    "color": "#172d2c"
  },
  "signals": [
    {
      "name": "iso",
      "value": "AUS"
    },
    {
      "name": "edgarYear",
      "value": 2024
    },
    {
      "name": "countryName",
      "update": "length(data('leaves')) ? data('leaves')[0].country : ''"
    }
  ],
  "data": [
    {
      "name": "sectors",
      "url": "data/sectors.csv",
      "format": {
        "type": "csv",
        "parse": {
          "value_mt": "number",
          "country_total_mt": "number"
        }
      }
    },
    {
      "name": "rootrow",
      "values": [
        {
          "id": "root"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "sectors",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.iso === iso"
        },
        {
          "type": "formula",
          "as": "id",
          "expr": "datum.sector"
        },
        {
          "type": "formula",
          "as": "parent",
          "expr": "'root'"
        }
      ]
    },
    {
      "name": "tree",
      "source": [
        "rootrow",
        "leaves"
      ],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value_mt",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.6,
          "paddingInner": 2,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "nodes",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": {
        "data": "sectors",
        "field": "sector",
        "sort": true
      },
      "range": [
        "#176b65",
        "#d35e38",
        "#7d6a9f",
        "#8c613c",
        "#4e8492",
        "#a33b3b",
        "#6b6b2a",
        "#555d66"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "#fffef9"
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "sector"
          },
          "tooltip": {
            "signal": "{'Sector': datum.sector, 'Million tonnes CO₂': format(datum.value_mt, ',.1f'), 'Share of country total': format(datum.value_mt / datum.country_total_mt, '.1%')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 7"
          },
          "y": {
            "signal": "datum.y0 + 18"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 80 && (datum.y1 - datum.y0) > 34 ? datum.sector + ' · ' + format(datum.value_mt / datum.country_total_mt, '.0%') : ''"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 12"
          },
          "fill": {
            "value": "#ffffff"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "font": {
            "value": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
          }
        }
      }
    }
  ]
}