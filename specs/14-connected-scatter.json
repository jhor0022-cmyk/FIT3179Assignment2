{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": 340,
  "description": "Connected scatterplot of CO2 per person against total CO2 (log scale) for five countries, joined in year order. The year range is chosen with two drop-downs (parameters yStart, yEnd).",
  "title": "Paths through time: per-person versus total CO₂",
  "params": [
    {
      "name": "yStart",
      "value": 1990
    },
    {
      "name": "yEnd",
      "value": 2024
    }
  ],
  "data": {
    "url": "data/connected.csv"
  },
  "transform": [
    {
      "filter": "datum.year >= yStart && datum.year <= yEnd"
    }
  ],
  "encoding": {
    "x": {
      "field": "co2_pc",
      "type": "quantitative",
      "title": "Tonnes of CO₂ per person per year",
      "scale": {
        "zero": false
      }
    },
    "y": {
      "field": "co2",
      "type": "quantitative",
      "title": "Total CO₂ (million tonnes, log scale)",
      "scale": {
        "type": "log"
      },
      "axis": {
        "format": ",.0f"
      }
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "scale": {
        "domain": [
          "China",
          "United States",
          "India",
          "Australia",
          "Malaysia"
        ],
        "range": [
          "#6b7b78",
          "#3b6fb6",
          "#2f8f5b",
          "#d35e38",
          "#b08b30"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom"
      }
    },
    "order": {
      "field": "year",
      "type": "quantitative"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.2,
        "point": {
          "filled": true,
          "size": 22
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year % 10 == 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "dy": -7,
        "fontSize": 10
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "quantitative",
          "format": "d"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "opacity": 0,
        "size": 80
      },
      "encoding": {
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "year",
            "title": "Year",
            "type": "quantitative",
            "format": "d"
          },
          {
            "field": "co2_pc",
            "title": "Tonnes per person",
            "type": "quantitative",
            "format": ".1f"
          },
          {
            "field": "co2",
            "title": "Total CO₂ (Mt)",
            "type": "quantitative",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "background": "#fffef9",
  "config": {
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#e4e8e0",
      "domainColor": "#9aa8a3",
      "tickColor": "#9aa8a3",
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#172d2c",
      "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    }
  }
}