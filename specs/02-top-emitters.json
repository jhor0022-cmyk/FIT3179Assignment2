{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": {
    "step": 25
  },
  "description": "Bar chart of the ten largest national CO2 emitters in the latest year, with Australia and Malaysia added for comparison.",
  "title": "Largest national emitters, latest year",
  "data": {
    "url": "data/top_emitters.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "co2",
          "type": "quantitative",
          "title": "Million tonnes of CO₂",
          "axis": {
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "co2",
            "title": "CO₂ (Mt)",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "rank",
            "title": "World rank",
            "type": "quantitative",
            "format": "d"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "color": "#536766"
      },
      "encoding": {
        "x": {
          "field": "co2",
          "type": "quantitative"
        },
        "text": {
          "field": "co2",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": {
        "field": "co2",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelLimit": 170,
        "domain": false,
        "ticks": false
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Top 10",
          "Australia",
          "Malaysia"
        ],
        "range": [
          "#176b65",
          "#d35e38",
          "#3b6fb6"
        ]
      },
      "legend": null
    }
  },
  "background": "#fffef9",
  "config": {
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#e4e8e0",
      "domainColor": "#9aa8a3",
      "tickColor": "#9aa8a3",
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#172d2c",
      "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    }
  }
}