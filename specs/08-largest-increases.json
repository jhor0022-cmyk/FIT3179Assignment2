{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": {
    "step": 25
  },
  "description": "Bar chart of the ten countries whose annual CO2 emissions grew most (in million tonnes) since 2000.",
  "title": "Biggest increases in annual CO₂ since 2000",
  "data": {
    "url": "data/increases.csv"
  },
  "encoding": {
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#b2182b",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "change_abs",
          "type": "quantitative",
          "title": "Increase in annual CO₂ (million tonnes)",
          "axis": {
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "change_abs",
            "title": "Increase (Mt)",
            "type": "quantitative",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "color": "#536766"
      },
      "encoding": {
        "x": {
          "field": "change_abs",
          "type": "quantitative"
        },
        "text": {
          "field": "change_abs",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "background": "#fffef9",
  "config": {
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#e4e8e0",
      "domainColor": "#9aa8a3",
      "tickColor": "#9aa8a3",
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#172d2c",
      "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    }
  }
}