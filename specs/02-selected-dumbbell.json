{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "background": "#fffef9",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#354b49",
      "gridColor": "#e5e9e4"
    }
  },
  "height": {
    "step": 30
  },
  "data": {
    "url": "data/selected-country-dumbbell.csv"
  },
  "description": "13 countries with the largest absolute changes in annual CO2 emissions between 2000 and 2024, plus Australia and Malaysia for audience context (15 total).",
  "encoding": {
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": {
        "field": "end",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelLimit": 155,
        "labelFontSize": 13
      }
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal"
      },
      {
        "field": "start",
        "type": "quantitative",
        "title": "2000 (Mt)",
        "format": ",.1f"
      },
      {
        "field": "end",
        "type": "quantitative",
        "title": "2024 (Mt)",
        "format": ",.1f"
      },
      {
        "field": "change",
        "type": "quantitative",
        "title": "Change (Mt)",
        "format": "+,.1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 5,
        "opacity": 0.55,
        "color": "#9dc5c2"
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "zero": true
          },
          "title": "Annual CO₂ (million tonnes; square-root scale)"
        },
        "x2": {
          "field": "end"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115,
        "color": "#aeb8c0"
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "color": "#237e89"
      },
      "encoding": {
        "x": {
          "field": "end",
          "type": "quantitative"
        }
      }
    }
  ]
}
