{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": 300,
  "description": "Streamgraph of CO2 emissions by world region since 1900; band thickness is the region's emissions.",
  "title": "CO₂ emissions by region since 1900 (band thickness = Mt CO₂)",
  "data": {
    "url": "data/regions.csv"
  },
  "mark": {
    "type": "area",
    "interpolate": "monotone"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "axis": {
        "format": "d",
        "tickCount": 8,
        "grid": false
      },
      "scale": {
        "nice": false
      }
    },
    "y": {
      "aggregate": "sum",
      "field": "co2",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "region",
      "type": "nominal",
      "scale": {
        "scheme": "tableau10"
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "columns": 3
      }
    },
    "tooltip": [
      {
        "field": "region",
        "title": "Region"
      },
      {
        "field": "year",
        "title": "Year",
        "type": "quantitative",
        "format": "d"
      },
      {
        "field": "co2",
        "title": "CO₂ (Mt)",
        "type": "quantitative",
        "format": ",.0f"
      }
    ]
  },
  "background": "#fffef9",
  "config": {
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#e4e8e0",
      "domainColor": "#9aa8a3",
      "tickColor": "#9aa8a3",
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#172d2c",
      "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    }
  }
}