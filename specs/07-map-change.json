{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 430,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "equalEarth"
  },
  "description": "Diverging choropleth of the percentage change in total CO2 emissions between 2000 and the latest year. Blue = fell, red = rose.",
  "title": "Change in total CO₂ emissions since 2000 (%)",
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id !== '010'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e3e6dc",
        "stroke": "#fffef9",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/change_since_2000.csv",
        "format": {
          "type": "csv",
          "parse": {
            "iso_num": "string"
          }
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": [
              "iso"
            ]
          }
        }
      ],
      "transform": [
        {
          "filter": "isValid(datum.change_pct)"
        },
        {
          "lookup": "iso_num",
          "from": {
            "data": {
              "url": "https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-110m.json",
              "format": {
                "type": "topojson",
                "feature": "countries"
              }
            },
            "key": "id"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape"
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "change_pct",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              -50,
              -25,
              -10,
              10,
              50,
              150
            ],
            "range": [
              "#2166ac",
              "#67a9cf",
              "#d1e5f0",
              "#f2f2ee",
              "#fddbc7",
              "#ef8a62",
              "#b2182b"
            ]
          },
          "legend": {
            "title": "% change, 2000 to latest year",
            "orient": "bottom",
            "direction": "horizontal",
            "titleLimit": 300
          }
        },
        "stroke": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": "#111"
          },
          "value": "#fffef9"
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1.8
          },
          "value": 0.4
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "co2_base",
            "title": "CO₂ in 2000 (Mt)",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "co2_latest",
            "title": "CO₂ latest year (Mt)",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "change_pct",
            "title": "Change (%)",
            "type": "quantitative",
            "format": "+,.0f"
          }
        ]
      }
    }
  ],
  "background": "#fffef9",
  "config": {
    "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#e4e8e0",
      "domainColor": "#9aa8a3",
      "tickColor": "#9aa8a3",
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#536766",
      "titleColor": "#172d2c"
    },
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#172d2c",
      "font": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    }
  }
}